# Local Worker secrets go in ignored .dev.vars. Never commit actual values.
# Optional model compilation; absent means clearly disclosed local parser mode.
# Gemini free-tier setup (requires eligible AI Studio project and quota).
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Legacy OpenAI adapter: explicitly select MODEL_PROVIDER=openai to use it.
MODEL_API_KEY=
MODEL_NAME=
# Optional authorized Fuyao/iFinD relay (see docs/DATA_CONTRACT.md).
DATA_RELAY_URL=
DATA_RELAY_TOKEN=
# Generate locally; set same value in .dev.vars and .env.scheduler.
SCHEDULER_SECRET=
